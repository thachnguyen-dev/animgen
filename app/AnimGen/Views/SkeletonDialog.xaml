<Window x:Class="AnimGen.Views.SkeletonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Khung xương nhân vật"
        Width="980" Height="760" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BrushWindow}" Foreground="{StaticResource BrushText}"
        FontFamily="{StaticResource FontUi}" FontSize="{StaticResource FontSizeBody}">
    <Grid Margin="{StaticResource PaddingPanel}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource WidthLeftPanel}"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- The joints -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextTitle}" Text="Kiểm tra khung xương"/>
                        <TextBlock Style="{StaticResource TextMuted}" Margin="{StaticResource SpaceGap}"
                                   Text="Máy đã đoán vị trí các khớp. Kéo khớp nào lệch về đúng chỗ trên nhân vật. “Phải” và “trái” là phía của chính nhân vật. Chỉ cần làm một lần cho mỗi ảnh."/>
                        <TextBlock x:Name="SourceText" Margin="{StaticResource SpaceGap}"/>
                        <TextBlock Text="Khớp" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ListBox x:Name="JointList" Height="220" Margin="{StaticResource SpaceGap}"
                                 SelectionChanged="JointList_SelectionChanged" AutomationProperties.Name="Khớp"/>
                        <TextBlock x:Name="JointHint" Margin="{StaticResource SpaceGap}" Text="Chọn một khớp hoặc kéo khớp trên ảnh."/>
                        <Button x:Name="RemoveJointButton" Content="Bỏ khớp này (bị che, không thấy)" Click="RemoveJoint_Click"
                                HorizontalAlignment="Left" IsEnabled="False"/>
                        <Button Content="Đặt lại như lúc đầu" Click="Reset_Click" HorizontalAlignment="Left"/>
                        <Button x:Name="ConfirmButton" Style="{StaticResource ButtonPrimary}" Content="Xác nhận khung xương" Click="Confirm_Click"/>
                    </StackPanel>
                </Border>

                <Border x:Name="StatusBorder" Style="{StaticResource Panel}" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock x:Name="StatusGlyph" Style="{StaticResource TextIcon}" Text="{StaticResource GlyphInfo}"/>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <Button Content="Đóng" Click="Close_Click" HorizontalAlignment="Right"/>
            </StackPanel>
        </ScrollViewer>

        <!-- The character with its joints -->
        <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextTitle}" Text="Kéo khớp để sửa, hoặc chọn khớp rồi bấm vào chỗ đúng"/>
                <Border Background="{StaticResource BrushChecker}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <Grid x:Name="ClickArea" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Cross"
                          MouseLeftButtonDown="ClickArea_MouseLeftButtonDown" MouseMove="ClickArea_MouseMove"
                          MouseLeftButtonUp="ClickArea_MouseLeftButtonUp" LostMouseCapture="ClickArea_LostMouseCapture">
                        <Image x:Name="CharacterImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               SizeChanged="CharacterImage_SizeChanged"/>
                        <Canvas x:Name="Markers" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
