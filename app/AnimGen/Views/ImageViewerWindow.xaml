<Window x:Class="AnimGen.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xem phóng to"
        Width="1100" Height="860" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BrushWindow}" Foreground="{StaticResource BrushText}"
        FontFamily="{StaticResource FontUi}" FontSize="{StaticResource FontSizeBody}">
    <Border Margin="{StaticResource PaddingPanel}" Style="{StaticResource Panel}">
        <DockPanel>
            <TextBlock x:Name="TitleText" DockPanel.Dock="Top" Style="{StaticResource TextTitle}"/>
            <DockPanel DockPanel.Dock="Top" Margin="{StaticResource SpaceGap}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Vừa khung" Click="Fit_Click" Padding="8,4" Margin="{StaticResource SpaceRight}"/>
                    <Button Content="100%" Click="Zoom_Click" Tag="1" Padding="8,4" Margin="{StaticResource SpaceRight}"
                            AutomationProperties.Name="Phóng 100%"/>
                    <Button Content="200%" Click="Zoom_Click" Tag="2" Padding="8,4" Margin="{StaticResource SpaceRight}"
                            AutomationProperties.Name="Phóng 200%"/>
                    <Button Content="400%" Click="Zoom_Click" Tag="4" Padding="8,4" Margin="{StaticResource SpaceRight}"
                            AutomationProperties.Name="Phóng 400%"/>
                    <TextBlock x:Name="ZoomText" Style="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Đóng" Click="Close_Click"/>
                <TextBlock Style="{StaticResource TextMuted}" VerticalAlignment="Center"
                           Text="Lăn chuột để phóng to hoặc thu nhỏ quanh con trỏ, kéo để di chuyển hình."/>
            </DockPanel>
            <Border Background="{StaticResource BrushChecker}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                    ClipToBounds="True">
                <Canvas x:Name="View" Background="Transparent" Cursor="SizeAll" SizeChanged="View_SizeChanged"
                        MouseWheel="View_MouseWheel" MouseLeftButtonDown="View_MouseLeftButtonDown"
                        MouseMove="View_MouseMove" MouseLeftButtonUp="View_MouseLeftButtonUp">
                    <Image x:Name="Picture" Stretch="None" AutomationProperties.Name="Hình phóng to">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Zoom"/>
                                <TranslateTransform x:Name="Pan"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Canvas>
            </Border>
        </DockPanel>
    </Border>
</Window>
