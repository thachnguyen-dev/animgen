<Window x:Class="AnimGen.Views.WeaponDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm vũ khí hoặc màu"
        Width="980" Height="700" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BrushWindow}" Foreground="{StaticResource BrushText}"
        FontFamily="{StaticResource FontUi}" FontSize="{StaticResource FontSizeBody}">
    <Grid Margin="{StaticResource PaddingPanel}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Step A: the images -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextTitle}" Text="A. Ảnh vũ khí"/>
                        <TextBlock Text="Tên vũ khí" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameBox" AutomationProperties.Name="Tên vũ khí"/>
                        <TextBlock Text="Loại" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="KindBox" SelectionChanged="KindBox_SelectionChanged" AutomationProperties.Name="Loại vũ khí">
                            <ComboBoxItem Tag="one_handed" Content="Một tay (kiếm, rìu, chuỳ, dao găm)" IsSelected="True"/>
                            <ComboBoxItem Tag="bow" Content="Cung (3 ảnh)"/>
                            <ComboBoxItem Tag="staff" Content="Gậy phép"/>
                            <ComboBoxItem Tag="two_handed" Content="Hai tay nặng (chưa có đòn)"/>
                            <ComboBoxItem Tag="polearm" Content="Cán dài (chưa có đòn)"/>
                        </ComboBox>
                        <TextBlock Text="Tên màu (skin)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="SkinBox" Text="mặc định" AutomationProperties.Name="Tên màu"/>
                        <ItemsControl x:Name="ImageSlots">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="{StaticResource SpaceGap}">
                                        <Button DockPanel.Dock="Right" Content="Chọn…" Padding="8,4" Margin="8,0,0,0"
                                                Click="ChooseImage_Click" Tag="{Binding}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding FileName}" Style="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource TextMuted}" Margin="{StaticResource SpaceGap}"
                                   Text="Vẽ vũ khí nhìn ngang, cùng tỉ lệ điểm ảnh với ảnh nhân vật, nền trong suốt thật. Màu mới cùng kích thước ảnh sẽ dùng lại điểm đã đặt."/>
                        <Button x:Name="SaveImagesButton" Style="{StaticResource ButtonPrimary}" Content="Lưu ảnh" Click="SaveImages_Click"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextTitle}" Text="B. Điểm cầm và đầu mũi"/>
                        <ComboBox x:Name="StageBox" SelectionChanged="StageBox_SelectionChanged" AutomationProperties.Name="Giai đoạn kéo cung"/>
                        <TextBlock x:Name="PointsHint" Margin="{StaticResource SpaceGap}" Text="Lưu ảnh trước."/>
                        <Button x:Name="ResetPointsButton" Content="Đặt lại hai điểm" Click="ResetPoints_Click" HorizontalAlignment="Left" IsEnabled="False"/>
                        <Button x:Name="SavePointsButton" Style="{StaticResource ButtonPrimary}" Content="Lưu điểm" Click="SavePoints_Click" IsEnabled="False"/>
                        <Button x:Name="PreviewButton" Content="Xem vũ khí trên tay nhân vật" Click="Preview_Click" IsEnabled="False"/>
                    </StackPanel>
                </Border>

                <Border x:Name="StatusBorder" Style="{StaticResource Panel}" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock x:Name="StatusGlyph" Style="{StaticResource TextIcon}" Text="{StaticResource GlyphInfo}"/>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <Button Content="Đóng" Click="Close_Click" HorizontalAlignment="Right"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Click area / preview -->
        <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="0">
            <DockPanel>
                <TextBlock x:Name="AreaTitle" DockPanel.Dock="Top" Style="{StaticResource TextTitle}" Text="Ảnh"/>
                <Border Background="{StaticResource BrushChecker}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <Grid>
                        <Grid x:Name="ClickArea" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Cross"
                              MouseLeftButtonDown="ClickArea_MouseLeftButtonDown">
                            <Image x:Name="WeaponImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   StretchDirection="Both" MaxWidth="1200" MaxHeight="1200"/>
                            <Canvas x:Name="Markers" IsHitTestVisible="False"/>
                        </Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
